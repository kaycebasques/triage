load("@rules_python//sphinxdocs:sphinx.bzl", "sphinx_build_binary", "sphinx_docs")
load("@rules_python//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")

package(default_visibility = ["//visibility:public"])

sphinx_docs_library(
    name = "docs",
    srcs = [
        "argument.rst",
        "conclusion.rst",
        "index.rst",
        "introduction.rst",
    ],
)

sphinx_build_binary(
    name = "sphinx",
    deps = [
        "@pypi//sphinx",
    ],
)

sphinx_docs(
    name = "2972",
    config = "conf.py",
    formats = ["html"],
    sphinx = ":sphinx",
    deps = [
        ":docs",
    ],
    allow_persistent_workers = False,
    extra_opts = [
        "--fail-on-warning",
    ],
)

alias(
    name = "ls",
    actual = ":_2972/_sources",
)

alias(
    name = "serve",
    actual = ":2972.serve",
)
